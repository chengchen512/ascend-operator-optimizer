def write_new_files(files: dict[Path, str], force: bool) -> None:
    existing = [path for path in files if path.exists() and not force]
    if existing:
        joined = "\n".join(f"  {path}" for path in existing)
        raise FileExistsError(f"files already exist:\n{joined}\nrerun with --force to overwrite")
    for path, content in files.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")


def cmd_doctor(_: argparse.Namespace) -> int:
    checks = [
        ("skill", SKILL_PATH.is_file()),
        ("optimctl executable", os.access(REPO_ROOT / "optimctl", os.X_OK)),
        ("task template", TASK_TEMPLATE.is_file()),
        ("report templates", REPORT_TEMPLATES.is_file()),
        ("knowledge", KNOWLEDGE_PATH.is_file()),
        ("constraints", CONSTRAINTS_PATH.is_file()),
        ("root SKILL.md moved", not (REPO_ROOT / "SKILL.md").exists()),
    ]
    for name, ok in checks:
        print(f"{'OK' if ok else 'FAIL'}  {name}")
    return 0 if all(ok for _, ok in checks) else 1


def cmd_init(args: argparse.Namespace) -> int:
    task_dir = Path(args.task_dir).expanduser().resolve()
    files = {
        task_dir / "optim_task.yaml": render_task(args),
        task_dir / "perf_cases.jsonl": "",
        task_dir / "baseline_report.md": extract_report_template("baseline_report.md"),
        task_dir / "precision_report.md": extract_report_template("precision_report.md"),
        task_dir / "performance_report.md": extract_report_template("performance_report.md"),
        task_dir / "optim_summary.md": render_summary(args),
    }
    try:
        write_new_files(files, args.force)
    except (FileExistsError, ValueError) as exc:
        return fail(str(exc))

    (task_dir / "failure_logs").mkdir(parents=True, exist_ok=True)
    print(f"initialized: {task_dir}")
    for path in files:
        print(path)
    print(task_dir / "failure_logs")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    task_file = Path(args.task_dir).expanduser().resolve() / "optim_task.yaml"
    if not task_file.is_file():
        return fail(f"missing task file: {task_file}")

    text = task_file.read_text(encoding="utf-8")
    framework = read_yaml_scalar(text, "framework")
    operator_name = read_yaml_scalar(text, "operator_name")
    print(f"task: {task_file}")
    print(f"framework: {framework or 'N/A'}")
    print(f"operator: {operator_name or 'N/A'}")
    for gate in GATES:
        status = read_gate_status(text, gate)
        print(f"{gate}: {status or 'N/A'}")
    return 0


def read_yaml_scalar(text: str, key: str) -> str:
    match = re.search(rf"^\s{{2}}{re.escape(key)}:\s*(.*)$", text, re.MULTILINE)
    if not match:
        return ""
    raw = match.group(1).strip()
    if raw.startswith('"') and raw.endswith('"'):
        try:
            return str(json.loads(raw))
        except json.JSONDecodeError:
            return raw.strip('"')
    return raw


def read_gate_status(text: str, gate: str) -> str:
    pattern = re.compile(
        rf"^  {re.escape(gate)}:\n    status:\s*(.*?)$",
        re.MULTILINE,
    )
    match = pattern.search(text)
    return match.group(1).strip() if match else ""


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="optimctl",
        description="Ascend operator optimization task helper.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="check repository layout")
    doctor.set_defaults(func=cmd_doctor)

    init = subparsers.add_parser("init", help="create optimization task files")
    init.add_argument("--task-dir", required=True, help="directory for task files")
    init.add_argument("--framework", choices=FRAMEWORKS, default="", help="operator framework")
    init.add_argument("--operator-name", default="", help="operator name")
    init.add_argument("--target-repo", default="", help="target repository")
    init.add_argument("--operator-dir", default="", help="operator source directory")
    init.add_argument("--design-or-notes", default="", help="design or notes file")
    init.add_argument("--operator-file", action="append", default=[], help="operator source file")
    init.add_argument("--testcase-doc", default="", help="test case document")
    init.add_argument("--perf-cases", default="", help="performance case jsonl")
    init.add_argument("--build-command", default="", help="build or compile command")
    init.add_argument("--precision-command", default="", help="precision command")
    init.add_argument("--performance-command", default="", help="performance command")
    init.add_argument("--profiler", default="", help="profiler command or tool")
    init.add_argument("--unit", default="us", help="measurement unit")
    init.add_argument("--warmup", default="", help="warmup count")
    init.add_argument("--repeat", default="", help="repeat count")
    init.add_argument("--active", default="", help="active profiling iterations")
    init.add_argument("--kernel-name", default="", help="kernel name")
    init.add_argument("--statistic", default="", help="statistic method")
    init.add_argument("--trace-dir", default="", help="trace directory")
    init.add_argument("--force", action="store_true", help="overwrite existing task files")
    init.set_defaults(func=cmd_init)

    status = subparsers.add_parser("status", help="show optimization task status")
    status.add_argument("--task-dir", required=True, help="directory containing optim_task.yaml")
    status.set_defaults(func=cmd_status)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
