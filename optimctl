#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parent
SKILL_PATH = REPO_ROOT / ".agents" / "skills" / "ascend-operator-optimizer" / "SKILL.md"
TASK_TEMPLATE = REPO_ROOT / "harness" / "task-template.yaml"
REPORT_TEMPLATES = REPO_ROOT / "harness" / "report-templates.md"
KNOWLEDGE_PATH = REPO_ROOT / "knowledge" / "ascend-operator-knowledge.md"
CONSTRAINTS_PATH = REPO_ROOT / "knowledge" / "constraints.md"

FRAMEWORKS = ("ascend-c", "triton-ascend", "tilelang-ascend")
REPORT_FILES = (
    "baseline_report.md",
    "precision_report.md",
    "performance_report.md",
)
GATES = ("context", "baseline", "build", "precision", "performance")


def fail(message: str) -> int:
    print(f"error: {message}", file=sys.stderr)
    return 1


def yaml_string(value: str | Path | None) -> str:
    if value is None:
        value = ""
    return json.dumps(str(value), ensure_ascii=False)


def yaml_list_field(key: str, values: list[str], indent: int = 2) -> str:
    prefix = " " * indent
    if not values:
        return f"{prefix}{key}: []"
    item_prefix = " " * (indent + 2)
    items = "\n".join(f"{item_prefix}- {yaml_string(value)}" for value in values)
    return f"{prefix}{key}:\n{items}"


def resolve_optional_path(value: str) -> str:
    if not value:
        return ""
    return str(Path(value).expanduser().resolve())


def git_commit(repo: str) -> str:
    if not repo:
        return ""
    try:
        result = subprocess.run(
            ["git", "-C", repo, "rev-parse", "--short", "HEAD"],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return ""
    return result.stdout.strip()


def extract_report_template(report_name: str) -> str:
    text = REPORT_TEMPLATES.read_text(encoding="utf-8")
    pattern = re.compile(
        rf"## {re.escape(report_name)}\n.*?```markdown\n(.*?)\n```",
        re.DOTALL,
    )
    match = pattern.search(text)
    if not match:
        raise ValueError(f"report template not found: {report_name}")
    return match.group(1).strip() + "\n"


def render_task(args: argparse.Namespace) -> str:
    started_at = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    target_repo = resolve_optional_path(args.target_repo)
    operator_dir = resolve_optional_path(args.operator_dir)
    test_dir = str(Path(args.task_dir).expanduser().resolve())
